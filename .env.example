# Server port
PORT=8787

# Shared secret required for POST/DELETE on /api/scenarios.
# Reads (/api/health, /api/dataset, /api/impact, GET /api/scenarios) remain public
# because this is a civic transparency tool.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUDGETBALLOT_WRITE_KEY=change-me-to-a-long-random-string
