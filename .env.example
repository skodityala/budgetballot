# Server port
PORT=8787

# Dev-only: overrides PORT for the Express API and is what vite.config.ts
# proxies /api to. Use this if something already holds 8787:
#   API_PORT=8801 WEB_PORT=5199 npm run dev
# In production PORT wins (hosting platforms inject it).
# API_PORT=8787
# WEB_PORT=5173

# Optional: directory for persisted scenarios. Point this at a writable volume
# in production (e.g. Render disk at /var/data). Defaults to server/data/.
# If the filesystem is read-only, the store degrades to in-memory and logs once.
# BUDGETBALLOT_DATA_DIR=/var/data

# Shared secret required for POST/DELETE on /api/scenarios.
# Reads (/api/health, /api/dataset, /api/impact, GET /api/scenarios) remain public
# because this is a civic transparency tool.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUDGETBALLOT_WRITE_KEY=change-me-to-a-long-random-string
